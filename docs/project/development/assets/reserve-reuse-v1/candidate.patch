+static void reused_storage() {
+    observed={};
+    Resource r;ready(r);
+    const auto pushes=observed.pushes,pops=observed.pops,waits=observed.completions;
+    for (unsigned int slot=0;slot<14;++slot)
+        assert(maelstrom_cuda_storage(&r,slot,nullptr,0,0).code==0);
+    assert(observed.pushes==pushes && observed.pops==pops && observed.completions==waits);
+    for (unsigned int slot=0;slot<14;++slot) {
+        assert(maelstrom_cuda_storage(&r,slot,nullptr,16,0).code==0);
+        unsigned char input[16];std::memset(input,static_cast<int>(slot+1),sizeof(input));
+        assert(maelstrom_cuda_storage(&r,slot,input,sizeof(input),1).code==0);
+    }
+    CUdeviceptr saved[14];std::copy(r.slots,r.slots+14,saved);
+    const auto memory=observed.memory;
+    const auto before_pushes=observed.pushes,before_pops=observed.pops,before_waits=observed.completions;
+    for (int failure : {0,7,10,13,16}) {
+        observed.fail=failure;
+        for (unsigned int slot=0;slot<14;++slot) {
+            for (std::size_t size : {0U,1U,15U,16U})
+                assert(maelstrom_cuda_storage(&r,slot,nullptr,size,0).code==0);
+            assert(r.slots[slot]==saved[slot] && r.capacities[slot]==16);
+        }
+        assert(!r.poisoned && observed.memory==memory);
+        assert(observed.pushes==before_pushes && observed.pops==before_pops && observed.completions==before_waits);
+    }
+    observed.fail=0;
+    assert(maelstrom_cuda_storage(&r,14,nullptr,0,0).stage==7);
+    assert(maelstrom_cuda_storage(&r,0,nullptr,0,3).stage==7);
+    assert(maelstrom_cuda_storage(&r,0,nullptr,1,1).stage==7);
+    assert(maelstrom_cuda_storage(&r,0,nullptr,1,2).stage==7);
+    assert(maelstrom_cuda_storage(&r,0,nullptr,static_cast<std::size_t>(PTRDIFF_MAX)+1,0).stage==7);
+    assert(observed.pushes==before_pushes && observed.completions==before_waits);
+    // Allocation exhaustion leaves every old allocation and its contents usable.
+    observed.fail=7;
+    assert(maelstrom_cuda_storage(&r,0,nullptr,17,0).stage==7 && !r.poisoned);
+    assert(observed.memory==memory && r.slots[0]==saved[0] && r.capacities[0]==16);
+    observed.fail=0;
+    for (unsigned int slot=0;slot<14;++slot) {
+        unsigned char output[16]{};
+        assert(maelstrom_cuda_storage(&r,slot,output,sizeof(output),2).code==0);
+        for (auto value : output) assert(value==slot+1);
+    }
+    assert(maelstrom_cuda_storage(&r,0,nullptr,32,0).code==0);
+    assert(r.capacities[0]==32 && r.slots[0]!=saved[0] && !observed.memory.count(saved[0]));
+    for (unsigned int slot=1;slot<14;++slot) assert(r.slots[slot]==saved[slot]);
+    // Empty transfers retain their driver/failure boundary; only reservation
+    // metadata is eligible for the fast path.
+    auto before=observed.completions;
+    assert(maelstrom_cuda_storage(&r,0,nullptr,0,1).code==0);
+    assert(maelstrom_cuda_storage(&r,0,nullptr,0,2).code==0);
+    assert(observed.completions==before+2);
+    observed.fail=10;
+    assert(maelstrom_cuda_storage(&r,0,nullptr,0,1).stage==10 && r.poisoned);
+    before=observed.completions;
+    assert(maelstrom_cuda_storage(&r,0,nullptr,0,0).stage==14);
+    assert(maelstrom_cuda_storage(&r,14,nullptr,0,3).stage==14);
+    assert(observed.completions==before);
+    observed.fail=0;
