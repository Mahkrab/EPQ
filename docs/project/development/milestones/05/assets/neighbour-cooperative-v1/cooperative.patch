+// A warp checks consecutive candidates for one spatially scheduled owner.
+// Ballots compact only integer membership; geometry and errors keep visit order.
+#pragma once
+extern "C" __global__ void discover_neighbours(SolverBuffers b, SolverSettings s, unsigned int operation) {
+    const auto row=(static_cast<std::uint64_t>(blockIdx.x)*blockDim.x+threadIdx.x)/32;
+    if (row>=s.count) return;
+    const unsigned int lane=threadIdx.x%32;
+    const auto i=b.cells[row].index;
+    Checked c;
+    if (s.validate_pairs) {
+        if (!lane) {
+            discover_row(b,s,i,c,operation==12);
+            b.errors[i]=c.error;
+            if (c.error && b.diagnostic) record_diagnostic(b,0,(static_cast<unsigned long long>(i)<<32)|c.error);
+        }
+        return;
+    }
+    const bool fill=operation==12;
+    const auto start=fill ? b.offsets[i] : 0;
+    const auto stop=fill ? b.offsets[i+1] : 0;
+    if (fill && (start>stop || stop>s.entries)) {
+        if (!lane) {
+            b.errors[i]=52;
+            if (b.diagnostic) record_diagnostic(b,0,(static_cast<unsigned long long>(i)<<32)|52);
+        }
+        return;
+    }
+    std::uint64_t cursor=start;
+    const Cell origin=cell(b.position[i],s.width,i);
+    for (int x=-1;x<=1;++x) for (int y=-1;y<=1;++y) {
+        Cell target{origin.x+x,origin.y+y,origin.z-1,0,0};
+        unsigned int lo=0,hi=s.count;
+        while (lo<hi) { auto mid=lo+(hi-lo)/2; if (less(b.cells[mid],target)) lo=mid+1; else hi=mid; }
+        auto k=static_cast<std::uint64_t>(lo);
+        for (int z=-1;z<=1;++z) {
+            target.z=origin.z+z;
+            while (true) {
+                const auto at=k+lane;
+                const bool present=at<s.count && same(b.cells[at],target);
+                const auto present_mask=__ballot_sync(0xffffffffU,present);
+                if (!present_mask) break;
+                Checked geometry;
+                unsigned int j=0;
+                bool member=false;
+                if (present) {
+                    j=b.cells[at].index;
+                    if (i!=j) member=separation(b.position[i],b.position[j],geometry)<s.radius;
+                }
+                const auto errors=__ballot_sync(0xffffffffU,geometry.error!=0);
+                const auto first_error=__shfl_sync(0xffffffffU,geometry.error,errors ? __ffs(errors)-1 : 0);
+                if (!c.error && errors) c.error=first_error;
+                const auto mask=__ballot_sync(0xffffffffU,member);
+                const auto members=__popc(mask);
+                if (fill) {
+                    if (cursor+members>stop) { c.error=52; break; }
+                    if (member) {
+                        const auto rank=__popc(mask&((1U<<lane)-1));
+                        auto offset=cursor+rank;
+                        if (s.neighbour_layout==1) {
+                            const auto offsets=reinterpret_cast<const std::uint64_t *>(b.cells+s.padded);
+                            offset=offsets[i/32]+(cursor-start+rank)*32+i%32;
+                        }
+                        b.neighbours[offset]=j;
+                    }
+                }
+                cursor+=members;
+                const auto visited=__popc(present_mask);
+                k+=visited;
+                if (visited<32) break;
+            }
+            if (c.error==52) break;
+        }
+        if (c.error==52) break;
+    }
+    if (!lane) {
+        if (fill) { if (cursor!=stop) c.error=52; }
+        else { if (!i) b.offsets[0]=0; b.offsets[i+1]=cursor; }
+        b.errors[i]=c.error;
+        if (c.error && b.diagnostic) record_diagnostic(b,0,(static_cast<unsigned long long>(i)<<32)|c.error);
+    }
+}
