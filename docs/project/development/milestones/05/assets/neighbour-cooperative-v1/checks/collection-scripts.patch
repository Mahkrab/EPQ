+from pathlib import Path
+import subprocess,json,os,shutil,hashlib,sys
+from tools.performance.timestep_report import identity
+r=Path(__file__).resolve().parent.parent
+env=os.environ|{'CARGO_TARGET_DIR':'/home/oliver/.cache/maelstrom-critical-target','MAELSTROM_CUDA_ARCH':'89'}
+def execute(name,cmd,cwd,extra=None):
+ with (r/f'{name}.log').open('x') as f:
+  p=subprocess.run(cmd,cwd=cwd,env=env|(extra or {}),stdout=f,stderr=subprocess.STDOUT)
+ if p.returncode: raise RuntimeError(f'{name}: {p.returncode}')
+ print(name,'PASS',flush=True)
+for v in (['spatial','geometry','cooperative'] if '--resume' in sys.argv else ['control','spatial','geometry','cooperative']):
+ source=r/v
+ (source/'build.rs').touch()
+ execute(f'{v}-witness-rebuilt',['cargo','build','--locked','--offline','--release','--features','cuda,viewer','--example','traversal_witness'],source)
+ shutil.copy2(Path(env['CARGO_TARGET_DIR'])/'release/examples/traversal_witness',r/f'{v}-witness-bin')
+ expected=identity(source,r/f'{v}-bin')['source_sha256']
+ assert expected.encode() in (r/f'{v}-witness-bin').read_bytes()
+ cases=[(110592,'experimental',1200,'default')]
+ if v in ['control','spatial']:
+  cases=[(n,m,1200 if m=='experimental' else 240,'default') for n in [8000,32000,110592] for m in ['experimental','reference','fast','paper-baseline','scene']]
+  cases += [(n,'experimental',240,'effects') for n in [32000,110592]]
+ for n,mode,steps,effects in cases:
+  out=r/'trajectories'/f'{v}-{n}-{mode}-{effects}.txt';out.parent.mkdir(exist_ok=True)
+  execute(f'witness-{v}-{n}-{mode}-{effects}',[str(r/f'{v}-witness-bin'),str(r/'inputs'/f'{n}.toml'),mode,str(steps),effects,str(out)],r)
+  if v!='control':
+   control=r/'trajectories'/f'control-{n}-{mode}-{effects}.txt'
+   assert out.read_bytes()==control.read_bytes(),out.name
+source=r/'control'
+(source/'build.rs').touch()
+base=['cargo','test','--locked','--offline','--release','--features','cuda,viewer']
+execute('control-suite',base,source)
+execute('control-cuda',base+['--lib','cuda::solver','--','--ignored','--test-threads=1'],source)
+for name,args in [('boundary',['--test','cuda_boundary','--','--ignored']),('execution',['--test','cuda_execution','--','--ignored','--test-threads=1']),('graphics',['--test','render_device','hardware','--','--ignored','--test-threads=1']),('viewer-model',['--lib','viewer::'])]:
+ execute(f'control-{name}',base+args,source)
+# Existing user whitespace is kept. A formatting diagnostic may report it;
+# retain its result without treating an unrelated pre-existing diff as a fix.
+with (r/'control-fmt.log').open('x') as f:
+ p=subprocess.run(['cargo','fmt','--check'],cwd=source,env=env,stdout=f,stderr=subprocess.STDOUT)
+(r/'control-fmt-status.json').write_text(json.dumps({'exit_code':p.returncode})+'\n')
+execute('control-clippy',['cargo','clippy','--locked','--offline','--release','--features','cuda,viewer','--all-targets','--','-D','warnings'],source)
+execute('control-native-build',['c++','-std=c++17','-g','-O1','-fsanitize=address,undefined','-fno-omit-frame-pointer','-I/usr/local/cuda/include','tests/native/tests.cpp','-ldl','-o',str(r/'control-native-test')],source)
+execute('control-native',[str(r/'control-native-test')],source,{'ASAN_OPTIONS':'detect_leaks=1'})
+# Find the exact built library test artefact from Cargo's structured output.
+p=subprocess.run(base+['--lib','--no-run','--message-format=json'],cwd=source,env=env,capture_output=True,text=True,check=True)
+artifacts=[json.loads(line) for line in p.stdout.splitlines() if line.startswith('{')]
+(r/'control-test-artifacts.json').write_text(json.dumps(artifacts,indent=2)+'\n')
+exe=next(x['executable'] for x in artifacts if x.get('reason')=='compiler-artifact' and x.get('executable') and x['target']['kind']==['lib'])
+for name,test in [('empty','tiled_empty_rows'),('tiled','tiled_density_matches_independent'),('cancel','tiled_attempts_keep_every_cancellation')]:
+ execute(f'control-memcheck-{name}',['/usr/local/cuda/bin/compute-sanitizer','--tool','memcheck','--error-exitcode','97',exe,test,'--ignored','--test-threads=1'],source)
+(r/'qualification-complete.json').write_text(json.dumps({'complete':True})+'\n')
