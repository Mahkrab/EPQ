+from pathlib import Path
+import subprocess,json,sys
+from tools.performance.live_viewer import run
+from tools.performance.timestep_report import identity,export_timeline,timeline,kernel_stages
+r=Path(__file__).resolve().parent.parent
+for v in sys.argv[1:]:
+ source=r/f'trace-{v}'; binary=r/f'trace-{v}-bin'
+ subprocess.run(['touch',str(source/'build.rs')],check=True)
+ env=__import__('os').environ|{'CARGO_TARGET_DIR':'/home/oliver/.cache/maelstrom-critical-target','MAELSTROM_CUDA_ARCH':'89'}
+ with (r/f'trace-{v}-build.log').open('w') as f:
+  subprocess.run(['cargo','build','--locked','--offline','--release','--features','cuda,viewer'],cwd=source,env=env,stdout=f,stderr=subprocess.STDOUT,check=True)
+ __import__('shutil').copy2(Path(env['CARGO_TARGET_DIR'])/'release/maelstrom',binary)
+ receipt=identity(source,binary)
+ ordinary=identity(r/v,r/f'{v}-bin')
+ assert receipt['ptx_sha256']==ordinary['ptx_sha256']
+ (r/f'trace-{v}-identity.json').write_text(json.dumps(receipt,indent=2)+'\n')
+ for n in ([8000,32000,110592] if v=='control' else [110592]):
+  out=r/'results'/f'trace-{v}-{n}'
+  run(binary,r/'inputs'/f'{n}.toml',out,1200,trace=True,renderer='impostor')
+  subprocess.run(['nsys','export','--type','sqlite','--output',str(out/'timeline.sqlite'),str(out/'timeline.nsys-rep')],check=True)
+  events=export_timeline(out/'timeline.sqlite')
+  stages=kernel_stages(events,n,n>=32000)
+  names={x['name'] for x in events if x['kind']=='kernel'}
+  assert names <= {'solver','observe_state','spatial_sort','prefix_counts','discover_neighbours'},names
+  if v=='cooperative':
+   assert sum(x['kind']=='kernel' and x['name']=='discover_neighbours' for x in events)==2400
+  result=timeline(events)|stages
+  (out/'analysis.json').write_text(json.dumps(result,indent=2)+'\n')
+  import gzip
+  (out/'analysis.events.json.gz').write_bytes(gzip.compress(json.dumps(events,separators=(',',':')).encode(),mtime=0))
+  print(json.dumps({'variant':v,'particles':n,'kernel_ms':result['kernel_ms_per_step']}),flush=True)
