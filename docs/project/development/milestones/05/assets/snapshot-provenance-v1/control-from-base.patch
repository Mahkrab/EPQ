+                        Plane::new(Vec3::new(1., 0., 0.), 1., 0.).unwrap(),
+                        Plane::new(Vec3::new(-1., 0., 0.), 0., 0.).unwrap(),
+                    ],
+                    2 => vec![
+                        Plane::new(Vec3::new(1., 0., 0.), -f32::MAX, 0.).unwrap(),
