+#[test]
+#[ignore = "requires an explicitly selected CUDA hardware test run"]
+fn hardware_components_preserve_ordered_cpu_arithmetic() {
+    use crate::{
+        config::parse_configuration_overlay, fluid::compute_jacobi_stage, neighbours::brute_force,
+        scene::load_resolved_scene,
+    };
+    let overlay = parse_configuration_overlay("[numerical]\nrefine_timestep=4").unwrap();
+    let scene = load_resolved_scene(
+        &std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("scenes/falling-block-04.toml"),
+        Some(&overlay),
+    )
+    .unwrap();
+    let mut gpu = CudaSolver::new(0, 128).unwrap();
+    let mut s = settings(
+        &scene.configuration,
+        scene.particles.len(),
+        scene.planes.len(),
+    )
+    .unwrap();
+    let mut serial = crate::simulation::Simulation::from_scene(&scene).unwrap();
+    let mut order_sensitive = false;
+    for step in 0..480 {
+        gpu.prepare(s, serial.snapshot().particles(), &scene.planes)
+            .unwrap();
+        gpu.operation(s, 0).unwrap();
+        gpu.operation(s, 1).unwrap();
+        let mut positions: Vec<Vec3> = gpu
+            .context
+            .inner
+            .download(2, s.count as usize)
+            .unwrap()
+            .into_iter()
+            .map(vector)
+            .collect();
+        gpu.discover(&mut s, &positions).unwrap();
+        let rows = brute_force(&positions, s.radius).unwrap();
+        if step == 0 {
+            for i in 0..positions.len() {
+                let weights: Vec<f32> = (0..positions.len())
+                    .filter(|&j| i == j || rows.for_particle(i).unwrap().contains(&j))
+                    .map(|j| {
+                        crate::kernel::poly6(
+                            (positions[i] - positions[j])
+                                .checked_length("independent order control")
+                                .unwrap(),
+                            s.radius,
+                        )
+                        .unwrap()
+                    })
+                    .collect();
+                let forward = weights.iter().fold(0.0_f32, |sum, w| sum + w);
+                let reverse = weights.iter().rev().fold(0.0_f32, |sum, w| sum + w);
+                order_sensitive |= forward.to_bits() != reverse.to_bits();
+            }
+        }
+        for iteration in 0..8 {
+            let cpu = compute_jacobi_stage(
+                &positions,
+                &rows,
+                scene.configuration.pbf_parameters().unwrap(),
+            )
+            .unwrap();
+            for op in [5, 6, 7, 8] {
+                gpu.operation(s, op).unwrap();
+            }
+            for (slot, expected) in [
+                (4, &cpu.normalised_densities),
+                (5, &cpu.constraints),
+                (6, &cpu.multipliers),
+            ] {
+                let values: Vec<f32> = gpu.context.inner.download(slot, positions.len()).unwrap();
+                for (i, (a, b)) in values.iter().zip(expected).enumerate() {
+                    assert_eq!(
+                        a.to_bits(),
+                        b.to_bits(),
+                        "iteration {iteration} slot {slot} particle {i}: {a} versus {b}"
+                    );
+                }
+            }
+            let corrections: Vec<[f32; 3]> =
+                gpu.context.inner.download(7, positions.len()).unwrap();
+            for (i, (a, b)) in corrections.iter().zip(&cpu.corrections).enumerate() {
+                assert_eq!(
+                    a.map(f32::to_bits),
+                    array(*b).map(f32::to_bits),
+                    "step {step} iteration {iteration} correction {i}: {a:?} versus {b:?}"
+                );
+            }
+            let expected: Vec<_> = positions
+                .iter()
+                .zip(&cpu.corrections)
+                .map(|(p, d)| crate::boundary::project_in_order(*p + *d, &scene.planes).unwrap())
+                .collect();
+            gpu.operation(s, 9).unwrap();
+            gpu.operation(s, 10).unwrap();
+            positions = gpu
+                .context
+                .inner
+                .download(2, positions.len())
+                .unwrap()
+                .into_iter()
+                .map(vector)
+                .collect();
+            assert_eq!(
+                positions
+                    .iter()
+                    .copied()
+                    .map(array)
+                    .map(|p| p.map(f32::to_bits))
+                    .collect::<Vec<_>>(),
+                expected
+                    .iter()
+                    .copied()
+                    .map(array)
+                    .map(|p| p.map(f32::to_bits))
+                    .collect::<Vec<_>>()
+            );
+        }
+        let _ = serial.step().unwrap();
+    }
+    assert!(
+        order_sensitive,
+        "the fixture must detect a reversed floating-point reduction"
+    );
+}
+
+#[test]
+#[ignore = "requires an explicitly selected CUDA hardware test run"]
+fn hardware_spatial_schedule_keeps_identity_rows_and_error_priority() {
+    use crate::neighbours::{brute_force, uniform_grid};
+
+    for threads in [32, 64, 128, 256] {
+        let mut gpu = CudaSolver::new(0, threads).unwrap();
+        for count in [33, 257, 4099, 65] {
+            let mut points: Vec<_> = (0..count)
+                .map(|i| {
+                    Vec3::new(
+                        (i % 37) as f32 * 0.04 - 0.8,
+                        ((i / 37) % 11) as f32 * 0.04 - 0.3,
+                        (i / (37 * 11)) as f32 * 0.04 - 0.2,
+                    )
+                })
+                .collect();
+            // Break the relationship between slice identity and spatial order.
+            // The oracle still enumerates neighbours in ascending slice order.
+            for i in (1..count).rev() {
+                points.swap(i, (i * 1664525 + 1013904223) % (i + 1));
+            }
+            let expected = if count < 300 {
+                brute_force(&points, 0.1).unwrap()
+            } else {
+                uniform_grid(&points, 0.1).unwrap()
+            };
+            let actual = discovered(&mut gpu, &points, 0.1).unwrap();
+            for (owner, row) in actual.iter().enumerate() {
+                assert_eq!(row, expected.for_particle(owner).unwrap());
+            }
+        }
+
+        // Spatial order visits the negative extreme first, but particle zero's
+        // displacement error must win. The unsafe-domain all-pairs check retains
+        // its identity-ordered traversal before any cell-local distance checks.
+        let points = [
+            Vec3::new(f32::MAX, 0., 0.),
+            Vec3::new(-f32::MAX, 0., 0.),
+            Vec3::ZERO,
+        ];
+        assert!(matches!(
+            discovered(&mut gpu, &points, 0.1),
+            Err(StepError::Numerical(NumericalError::NonFiniteResult {
+                quantity: "neighbour search displacement"
+            }))
+        ));
+        assert_eq!(
+            gpu.context.inner.download::<u32>(12, 3).unwrap(),
+            vec![1, 1, 2]
+        );
+        assert!(gpu.accept().is_err());
+        assert_eq!(
+            discovered(&mut gpu, &[Vec3::ZERO; 3], 0.1).unwrap(),
+            vec![vec![1, 2], vec![0, 2], vec![0, 1]]
+        );
+    }
+}
diff -ruN base/tests/unit/cuda/spatial_sort_tests.rs control/tests/unit/cuda/spatial_sort_tests.rs
--- base/tests/unit/cuda/spatial_sort_tests.rs	1970-01-01 01:00:00.000000000 +0100
+++ control/tests/unit/cuda/spatial_sort_tests.rs	2026-10-27 12:53:12.893504142 +0000
@@ -0,0 +1,63 @@
+//! Raw cell keys exercise the complete signed ordering independently of floating
+//! point cell construction. Padding duplicates must survive every merge boundary.
+
+use super::*;
+
+#[test]
+#[ignore = "requires an explicitly selected CUDA hardware test run"]
+fn hardware_spatial_sort_preserves_full_keys_padding_and_reused_storage() {
+    let config = crate::config::resolve_effective_configuration(None, None, None).unwrap();
+    for threads in [32, 64, 128, 256] {
+        let mut gpu = CudaSolver::new(0, threads).unwrap();
+        for count in [0, 1, 2, 127, 128, 129, 257, 1025, 4097, 129] {
+            let particles = vec![
+                Particle {
+                    identity: 0,
+                    position_m: Vec3::ZERO,
+                    velocity_m_s: Vec3::ZERO,
+                };
+                count
+            ];
+            let s = settings(&config, count, 0).unwrap();
+            gpu.prepare(s, &particles, &[]).unwrap();
+            let coordinates = [i64::MIN, -(1_i64 << 52), -1, 0, 1, 1_i64 << 52, i64::MAX];
+            let mut keys: Vec<_> = (0..count)
+                .map(|i| {
+                    (
+                        coordinates[(i * 13) % coordinates.len()],
+                        coordinates[(i / 3) % coordinates.len()],
+                        coordinates[(i / 11) % coordinates.len()],
+                        i as u32,
+                    )
+                })
+                .collect();
+            keys.reverse();
+            let mut packed: Vec<u64> = keys
+                .iter()
+                .flat_map(|&(x, y, z, index)| [x as u64, y as u64, z as u64, u64::from(index)])
+                .collect();
+            let sentinel = [
+                i64::MAX as u64,
+                i64::MAX as u64,
+                i64::MAX as u64,
+                u32::MAX as u64,
+            ];
+            for _ in count..s.padded as usize {
+                packed.extend(sentinel);
+            }
+            gpu.context.inner.upload(10, &packed).unwrap();
+            gpu.context.inner.launch(s, 13, threads).unwrap();
+            let sorted: Vec<u64> = gpu.context.inner.download(10, packed.len()).unwrap();
+            keys.sort_unstable();
+            let actual: Vec<_> = sorted
+                .chunks_exact(4)
+                .take(count)
+                .map(|c| (c[0] as i64, c[1] as i64, c[2] as i64, c[3] as u32))
+                .collect();
+            assert_eq!(actual, keys, "count {count}, block {threads}");
+            for padding in sorted.chunks_exact(4).skip(count) {
+                assert_eq!(padding, sentinel);
+            }
+        }
+    }
+}
diff -ruN base/tests/unit/cuda/vorticity_tests.rs control/tests/unit/cuda/vorticity_tests.rs
--- base/tests/unit/cuda/vorticity_tests.rs	1970-01-01 01:00:00.000000000 +0100
+++ control/tests/unit/cuda/vorticity_tests.rs	2026-10-26 10:23:30.458422422 +0000
@@ -0,0 +1,130 @@
+//! Direct device stages check separate output and retry after numerical failure,
+//! including final-position changes that the fixed prediction rows cannot know.
+
+use super::*;
+use crate::{
+    fluid::InteractionSets,
+    velocity::{VorticityParameters, vorticity_confinement},
+};
+
+#[test]
+#[ignore = "requires an explicitly selected CUDA hardware test run"]
+fn confinement_stages_preserve_input_and_retry_both_numerical_failure_paths() {
+    for threads in [32, 64, 128, 256] {
+        let configuration =
+            crate::config::resolve_effective_configuration(None, None, None).unwrap();
+        let initial = [
+            Vec3::ZERO,
+            Vec3::new(0.25, 0., 0.),
+            Vec3::new(0.5, 0.125, 0.),
+            Vec3::new(0., 0.25, 0.125),
+        ];
+        let velocities = [
+            Vec3::ZERO,
+            Vec3::new(0., 0.25, 0.125),
+            Vec3::new(-0.25, 0.5, 0.),
+            Vec3::new(0.125, 0., -0.125),
+        ];
+        let particles: Vec<_> = initial
+            .iter()
+            .enumerate()
+            .map(|(i, &p)| Particle {
+                identity: i as u64,
+                position_m: p,
+                velocity_m_s: velocities[i],
+            })
+            .collect();
+        let rows = InteractionSets::new(
+            (0..4)
+                .map(|i| (0..4).filter(|&j| i != j).collect())
+                .collect(),
+        )
+        .unwrap();
+        let mut gpu = CudaSolver::new(0, threads).unwrap();
+        let mut s = settings(&configuration, 4, 0).unwrap();
+        s.radius = 1.;
+        s.rest_density = 4.;
+        s.vorticity = 0.125;
+        s.timestep = 0.0625;
+        gpu.prepare(s, &particles, &[]).unwrap();
+        gpu.context.inner.upload(2, &initial.map(array)).unwrap();
+        gpu.discover(&mut s, &initial).unwrap();
+        for distance in [
+            0.,
+            0.25,
+            f32::from_bits(1f32.to_bits() - 1),
+            1.,
+            f32::from_bits(1f32.to_bits() + 1),
+        ] {
+            let mut positions = initial;
+            positions[1] = Vec3::new(distance, 0., 0.);
+            gpu.context.inner.upload(2, &positions.map(array)).unwrap();
+            gpu.context.inner.upload(3, &velocities.map(array)).unwrap();
+            gpu.operation(s, 16).unwrap();
+            gpu.operation(s, 17).unwrap();
+            let before: Vec<[f32; 3]> = gpu.context.inner.download(3, 4).unwrap();
+            assert_eq!(before, velocities.map(array));
+            let actual: Vec<[f32; 3]> = gpu.context.inner.download(8, 4).unwrap();
+            let expected = vorticity_confinement(
+                &positions,
+                &velocities,
+                &rows,
+                VorticityParameters {
+                    radius_m: 1.,
+                    rest_density_per_m3: 4.,
+                    strength_m_s: s.vorticity,
+                    timestep_s: s.timestep,
+                },
+            )
+            .unwrap();
+            for (a, e) in actual.iter().zip(&expected) {
+                assert_eq!(a.map(f32::to_bits), array(*e).map(f32::to_bits));
+            }
+            gpu.operation(s, 15).unwrap();
+            let copied: Vec<[f32; 3]> = gpu.context.inner.download(3, 4).unwrap();
+            assert_eq!(copied, actual);
+        }
+        for failing_operation in [16, 17] {
+            gpu.context.inner.upload(2, &initial.map(array)).unwrap();
+            let mut bad = velocities;
+            if failing_operation == 16 {
+                bad[0].x = f32::MAX;
+                bad[1].x = -f32::MAX;
+            }
+            gpu.context.inner.upload(3, &bad.map(array)).unwrap();
+            let mut invalid = s;
+            if failing_operation == 17 {
+                invalid.vorticity = f32::MAX;
+                invalid.timestep = f32::MAX;
+                gpu.operation(invalid, 16).unwrap();
+            }
+            assert!(matches!(
+                gpu.operation(invalid, failing_operation),
+                Err(StepError::Numerical(_))
+            ));
+            let unchanged: Vec<[f32; 3]> = gpu.context.inner.download(3, 4).unwrap();
+            assert_eq!(unchanged, bad.map(array));
+            gpu.context.inner.begin_attempt().unwrap();
+            gpu.context.inner.upload(3, &velocities.map(array)).unwrap();
+            gpu.operation(s, 16).unwrap();
+            gpu.operation(s, 17).unwrap();
+            gpu.operation(s, 15).unwrap();
+            let expected = vorticity_confinement(
+                &initial,
+                &velocities,
+                &rows,
+                VorticityParameters {
+                    radius_m: 1.,
+                    rest_density_per_m3: 4.,
+                    strength_m_s: s.vorticity,
+                    timestep_s: s.timestep,
+                },
+            )
+            .unwrap();
+            let actual: Vec<[f32; 3]> = gpu.context.inner.download(3, 4).unwrap();
+            for (a, e) in actual.iter().zip(expected) {
+                assert_eq!(a.map(f32::to_bits), array(e).map(f32::to_bits));
+            }
+        }
+    }
+}
