+        s.neighbour_layout = 1;
+        gpu.prepare(s, &particles, &[]).unwrap();
+        let scratch = vec![0xa5a5a5a5_u32; storage_sizes(s).unwrap()[10] / 4];
+        gpu.context.inner.upload(10, &scratch).unwrap();
+        let mut counts = vec![0_u64; 34];
