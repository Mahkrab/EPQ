+        atomicMin(b.diagnostic+1,(static_cast<unsigned long long>(particle)<<32)|52);
+        value=0;
+    }
+    scan[lane]=value;
+    inclusive_block_prefix(scan);
+    if (i<n) b.offsets[i]=scan[lane];
+    if (lane==blockDim.x-1) totals[blockIdx.x]=scan[lane];
