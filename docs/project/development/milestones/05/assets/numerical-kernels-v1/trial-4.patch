+// This entry uses the same stream-wide proof as grouped correction. Its private
+// resource requirement is independent of discovery and density/lambda code.
+extern "C" __global__ void validated_correction(SolverBuffers b, SolverSettings s, unsigned int) {
+    const auto lane=static_cast<std::uint64_t>(blockIdx.x)*blockDim.x+threadIdx.x;
+    if (lane>=s.count) return;
+    for (unsigned int previous=0;previous<2;++previous)
+        if (b.diagnostic[previous]!=ULLONG_MAX) return;
+    const auto i=static_cast<unsigned int>(lane);
+    Checked c;
+    ValidatedGeometry geometry;
+    calculate_correction(b,s,i,c,geometry);
+    b.errors[i]=c.error;
+    if (c.error && b.diagnostic) record_diagnostic(b,2,(static_cast<unsigned long long>(i)<<32)|c.error);
