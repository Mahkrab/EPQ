+struct ValidatedGeometry {
+    __device__ float scalar(float value, unsigned int) { return value; }
+    __device__ Vector vector(Vector value, unsigned int) { return value; }
+};
+template<class Geometry>
+__device__ void calculate_correction(SolverBuffers b, SolverSettings s, unsigned int i,
+                                     Checked &c, Geometry &geometry) {
+    Vector sum{0,0,0};
+    Members correction_row(b,s,i);
+    for (auto j=correction_row.next(s.count);j<s.count;j=correction_row.next(s.count)) if (active(b,s,i,j,geometry)) {
+        Vector displacement=sub(b.position[i],b.position[j]);
+        float distance=separation(b.position[i],b.position[j],geometry,18);
+        Vector direction=spiky(displacement,s.radius,geometry);
+        float weight=poly6(distance,s.radius,geometry), pressure=0;
+        if (weight!=0 && s.strength!=0) {
+        float ratio=c.scalar(__fdiv_rn(weight,s.reference_weight),34);
