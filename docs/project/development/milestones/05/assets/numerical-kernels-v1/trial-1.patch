+    __device__ float weight(float d, float h, Checked &c) const {
+        if (d>=h) return 0.0f;
+        float hh=c.scalar(h2,4), d2=c.scalar(d*d,5);
+        float term=c.scalar(hh-d2,6);
+        if (!c.error) c.error=poly_error;
+        float cube=c.scalar(term*(term*term),10);
+        return c.scalar(poly*cube,11);
