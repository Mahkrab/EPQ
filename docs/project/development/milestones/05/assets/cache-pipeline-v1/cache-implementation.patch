+++ b/src/cache/format.rs
@@ -0,0 +1,188 @@
+//! Fixed little-endian arrays preserve binary32 bits and stable row identities.
+//! The canonical digest is inside the checked frame, binding it to the payload.
+use super::*;
+use crate::{math::Vec3, scene::Particle, workflow::SnapshotRecord};
+
+pub(super) const HEADER: usize = 160;
+const MAGIC: &[u8; 8] = b"MSPCACHE";
+
+/// Compact accepted-step schedule, including both endpoints. No frame array is allocated.
+#[derive(Debug, Clone, Copy)]
+pub struct Schedule {
+    last: u64,
+    stride: u64,
+    count: u64,
+}
+impl Schedule {
+    /// Rejects zero stride, overflow and more than one million observations.
+    pub fn new(last: u64, stride: u64) -> Result<Self, CacheError> {
+        if stride == 0 {
+            return Err(invalid("step stride must be positive"));
+        }
+        let count = (last / stride)
+            .checked_add(1)
+            .and_then(|n| n.checked_add(u64::from(!last.is_multiple_of(stride))))
+            .ok_or_else(|| invalid("frame count overflow"))?;
+        if count > 1_000_000 {
+            return Err(invalid("frame count exceeds 1000000"));
+        }
+        Ok(Self {
+            last,
+            stride,
+            count,
+        })
+    }
+    /// Number of observations, including the initial observation.
+    pub fn len(self) -> u64 {
+        self.count
+    }
+    /// Schedules always contain the initial observation.
+    pub fn is_empty(self) -> bool {
+        false
+    }
+    /// Accepted step for an output index, or None outside the schedule.
+    pub fn step(self, index: u64) -> Option<u64> {
+        (index < self.count).then(|| index.saturating_mul(self.stride).min(self.last))
+    }
+}
+
+pub(super) fn size(count: usize) -> Result<usize, CacheError> {
+    count
+        .checked_mul(24)
+        .and_then(|n| n.checked_add(HEADER))
+        .ok_or_else(|| invalid("cache frame length overflow"))
+}
+fn put(bytes: &mut [u8], offset: usize, value: u64) {
+    bytes[offset..offset + 8].copy_from_slice(&value.to_le_bytes());
+}
+fn get(bytes: &[u8], offset: usize) -> Result<u64, CacheError> {
+    Ok(u64::from_le_bytes(
+        bytes
+            .get(offset..offset + 8)
+            .ok_or_else(|| invalid("short cache header"))?
+            .try_into()
+            .map_err(invalid)?,
+    ))
+}
+fn raw_digest(text: &str) -> Result<[u8; 32], CacheError> {
+    if !valid_digest(text) {
+        return Err(invalid("invalid cache digest"));
+    }
+    let mut digest = [0; 32];
+    for (i, pair) in text.as_bytes()[7..].as_chunks::<2>().0.iter().enumerate() {
+        let digit = |b: u8| if b <= b'9' { b - b'0' } else { b - b'a' + 10 };
+        digest[i] = digit(pair[0]) * 16 + digit(pair[1]);
+    }
+    Ok(digest)
+}
+pub(super) fn encode(
+    snapshot: &SnapshotRecord,
+    index: u64,
+    request: &str,
+    canonical: [u8; 32],
+) -> Result<Vec<u8>, CacheError> {
+    let n = snapshot.particles().len();
+    let len = size(n)?;
+    let mut bytes = Vec::new();
+    bytes.try_reserve_exact(len).map_err(invalid)?;
+    bytes.resize(len, 0);
+    bytes[..8].copy_from_slice(MAGIC);
+    bytes[8..10].copy_from_slice(&1u16.to_le_bytes());
+    bytes[12..16].copy_from_slice(&(HEADER as u32).to_le_bytes());
+    for (o, v) in [
+        (16, index),
+        (24, snapshot.completed_steps()),
+        (32, n as u64),
+        (40, (24 * n) as u64),
+        (48, (24 * n) as u64),
+        (56, HEADER as u64),
+        (64, (HEADER + 12 * n) as u64),
+    ] {
+        put(&mut bytes, o, v);
+    }
+    bytes[80..112].copy_from_slice(&raw_digest(request)?);
+    bytes[112..144].copy_from_slice(&canonical);
+    for (i, r) in snapshot.particles().iter().enumerate() {
+        let p = r.particle();
+        for (offset, v) in [
+            (HEADER + 12 * i, p.position_m),
+            (HEADER + 12 * n + 12 * i, p.velocity_m_s),
+        ] {
+            for (j, f) in [v.x, v.y, v.z].iter().enumerate() {
+                bytes[offset + 4 * j..offset + 4 * j + 4]
+                    .copy_from_slice(&f.to_bits().to_le_bytes());
+            }
+        }
+    }
+    Ok(bytes)
+}
+pub(super) fn decode(
+    bytes: &[u8],
+    receipt: &Receipt,
+    request: &str,
+    initial: &[Particle],
+) -> Result<(SnapshotRecord, [u8; 32], f64), CacheError> {
+    let validation_started = std::time::Instant::now();
+    let n = initial.len();
+    if bytes.len() != size(n)?
+        || bytes.len() as u64 != receipt.bytes
+        || bytes.get(..8) != Some(MAGIC.as_slice())
+    {
+        return Err(invalid("cache frame length or magic mismatch"));
+    }
+    if bytes[8..12] != [1, 0, 0, 0]
+        || bytes[12..16] != (HEADER as u32).to_le_bytes()
+        || bytes[72..80] != [0; 8]
+        || bytes[144..160] != [0; 16]
+    {
+        return Err(invalid("unsupported cache frame version, codec or flags"));
+    }
+    for (o, v) in [
+        (16, receipt.index),
+        (24, decimal(&receipt.step)?),
+        (32, n as u64),
+        (40, (24 * n) as u64),
+        (48, (24 * n) as u64),
+        (56, HEADER as u64),
+        (64, (HEADER + 12 * n) as u64),
+    ] {
+        if get(bytes, o)? != v {
+            return Err(invalid(
+                "cache frame header disagrees with receipt or layout",
+            ));
+        }
+    }
+    if bytes[80..112] != raw_digest(request)?
+        || bytes[112..144] != raw_digest(&receipt.snapshot_sha256)?
+        || digest(bytes) != receipt.file_sha256
+    {
+        return Err(invalid(
+            "cache frame checksum, request or canonical binding mismatch",
+        ));
+    }
+    let validation_s = validation_started.elapsed().as_secs_f64();
+    let mut particles = Vec::new();
+    particles.try_reserve_exact(n).map_err(invalid)?;
+    for (i, p) in initial.iter().enumerate() {
+        let vector = |offset: usize| -> Result<Vec3, CacheError> {
+            let f = |j: usize| -> Result<f32, CacheError> {
+                Ok(f32::from_bits(u32::from_le_bytes(
+                    bytes[offset + j * 4..offset + j * 4 + 4]
+                        .try_into()
+                        .map_err(invalid)?,
+                )))
+            };
+            Ok(Vec3::new(f(0)?, f(1)?, f(2)?))
+        };
+        particles.push(Particle {
+            identity: p.identity,
+            position_m: vector(HEADER + 12 * i)?,
+            velocity_m_s: vector(HEADER + 12 * n + 12 * i)?,
+        });
+    }
+    Ok((
+        SnapshotRecord::from_particles(particles, decimal(&receipt.step)?).map_err(invalid)?,
+        raw_digest(&receipt.snapshot_sha256)?,
+        validation_s,
+    ))
+}
diff --git a/b/src/cache/mod.rs b/src/cache/mod.rs
new file mode 100644
index 0000000..75471b1
--- /dev/null
+++ b/src/cache/mod.rs
@@ -0,0 +1,191 @@
+//! Particle caches retain scheduled accepted observations independently of images.
+//! Frames and receipts are immutable; only a completed manifest certifies the
+//! requested sequence. Reading a cache never constructs a simulation or a device.
+
+mod bake;
+mod format;
+mod reader;
+mod writer;
+
+pub use bake::{BakeRequest, bake};
+pub use format::Schedule;
+pub use reader::{Cache, ReadTimings, ValidatedFrame};
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    fmt, fs,
+    io::{self, Read},
+    path::Path,
+};
+
+/// An invalid cache, a failed operation, cancellation, or a lost writer.
+#[derive(Debug)]
+pub enum CacheError {
+    /// Unsupported, inconsistent or corrupt input.
+    Invalid(String),
+    /// Filesystem operation failed; any committed prefix is retained.
+    Io(io::Error),
+    /// Cooperative cancellation before completion publication.
+    Cancelled,
+    /// The bounded writer stopped without returning its result.
+    WriterStopped,
+}
+impl fmt::Display for CacheError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Invalid(s) => f.write_str(s),
+            Self::Io(e) => write!(f, "cache I/O: {e}"),
+            Self::Cancelled => f.write_str("cache bake cancelled"),
+            Self::WriterStopped => f.write_str("cache writer stopped before completing its frame"),
+        }
+    }
+}
+impl std::error::Error for CacheError {}
+impl From<io::Error> for CacheError {
+    fn from(e: io::Error) -> Self {
+        Self::Io(e)
+    }
+}
+impl From<serde_json::Error> for CacheError {
+    fn from(e: serde_json::Error) -> Self {
+        invalid(format!("cache JSON: {e}"))
+    }
+}
+pub(crate) fn invalid(s: impl fmt::Display) -> CacheError {
+    CacheError::Invalid(s.to_string())
+}
+pub(crate) fn digest(bytes: &[u8]) -> String {
+    hex(Sha256::digest(bytes).as_slice())
+}
+pub(crate) fn hex(bytes: &[u8]) -> String {
+    format!(
+        "sha256:{}",
+        bytes.iter().map(|b| format!("{b:02x}")).collect::<String>()
+    )
+}
+fn valid_digest(s: &str) -> bool {
+    s.strip_prefix("sha256:").is_some_and(|s| {
+        s.len() == 64
+            && s.bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    })
+}
+
+/// Build identity is recorded even in headless cache producers.
+pub(crate) fn build_identity() -> serde_json::Value {
+    serde_json::json!({"commit":option_env!("MAELSTROM_EXPORT_COMMIT"),"dirty":option_env!("MAELSTROM_EXPORT_DIRTY"),"source_sha256":option_env!("MAELSTROM_EXPORT_SOURCE"),"lock_sha256":option_env!("MAELSTROM_EXPORT_LOCK"),"rustc":option_env!("MAELSTROM_EXPORT_RUSTC"),"target":option_env!("MAELSTROM_EXPORT_TARGET"),"profile":option_env!("MAELSTROM_EXPORT_PROFILE"),"opt_level":option_env!("MAELSTROM_EXPORT_OPT_LEVEL"),"rustflags_sha256":option_env!("MAELSTROM_EXPORT_CARGO_ENCODED_RUSTFLAGS"),"debug_assertions":cfg!(debug_assertions),"features":{"cuda":cfg!(feature="cuda"),"render":cfg!(feature="render"),"viewer":cfg!(feature="viewer")}})
+}
+
+// Keep wire structs private: callers cannot manufacture a validated frame or digest.
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    schema_version: u32,
+    kind: String,
+    steps: String,
+    stride: String,
+    particle_count: usize,
+    timestep_bits: u32,
+    input_sha256: String,
+    identities_sha256: String,
+    execution: crate::execution::ExecutionMode,
+    backend: String,
+    metadata: serde_json::Value,
+    build: serde_json::Value,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Receipt {
+    schema_version: u32,
+    index: u64,
+    step: String,
+    bytes: u64,
+    file_sha256: String,
+    snapshot_sha256: String,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Completion {
+    schema_version: u32,
+    complete: bool,
+    request_sha256: String,
+    frames: u64,
+    accepted_steps: String,
+    warnings: u64,
+    receipts_sha256: String,
+    diagnostics_sha256: String,
+    cache_id: String,
+    timings: serde_json::Value,
+}
+
+fn decimal(s: &str) -> Result<u64, CacheError> {
+    let n: u64 = s.parse().map_err(invalid)?;
+    if n.to_string() != s {
+        return Err(invalid("non-canonical cache step"));
+    }
+    Ok(n)
+}
+
+// Refuse symlinks and verify the opened object too. Linux O_NOFOLLOW closes the
+// final-component race; all intermediate cache directories are checked at open/use.
+fn regular(path: &Path, limit: u64) -> Result<fs::File, CacheError> {
+    let m = fs::symlink_metadata(path)?;
+    if !m.is_file() || m.len() > limit {
+        return Err(invalid("expected a bounded regular cache file"));
+    }
+    let mut options = fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(target_os = "linux")]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(0x20000);
+    }
+    let file = options.open(path)?;
+    let opened = file.metadata()?;
+    if !opened.is_file() || opened.len() > limit {
+        return Err(invalid("opened cache file exceeds its limit"));
+    }
+    Ok(file)
+}
+fn directory(path: &Path) -> Result<(), CacheError> {
+    if !fs::symlink_metadata(path)?.is_dir() {
+        return Err(invalid("expected a cache directory, not a symlink"));
+    }
+    Ok(())
+}
+fn read(path: &Path, limit: u64) -> Result<Vec<u8>, CacheError> {
+    let file = regular(path, limit)?;
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(usize::try_from(file.metadata()?.len()).map_err(invalid)?)
+        .map_err(invalid)?;
+    file.take(limit + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > limit {
+        return Err(invalid("cache file grew beyond its limit"));
+    }
+    Ok(bytes)
+}
+fn sync_directory(path: &Path) -> Result<(), CacheError> {
+    #[cfg(unix)]
+    fs::File::open(path)?.sync_all()?;
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
+fn publish(path: &Path, bytes: &[u8]) -> Result<(), CacheError> {
+    crate::workflow::publish_bytes(path, bytes)?;
+    Ok(())
+}
+fn receipt_name(index: u64) -> String {
+    format!("frame-{index:08}.json")
+}
+fn frame_name(index: u64) -> String {
+    format!("frame-{index:08}.mpc")
+}
+fn result_id(request: &str, receipts: &str, diagnostics: &str) -> String {
+    digest(format!("maelstrom-cache-v1|{request}|{receipts}|{diagnostics}").as_bytes())
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/b/src/cache/reader.rs b/src/cache/reader.rs
