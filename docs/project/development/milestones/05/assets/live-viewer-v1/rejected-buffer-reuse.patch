+#[derive(Default)]
+struct Uploads {
+    centres: VertexUpload,
+    lines: VertexUpload,
+    overlay: VertexUpload,
+}
+
+#[derive(Default)]
+struct VertexUpload {
+    buffer: Option<wgpu::Buffer>,
+}
+impl VertexUpload {
+    fn update(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        label: &str,
+        values: &[f32],
+    ) -> Result<&wgpu::Buffer, RenderError> {
+        let values = if values.is_empty() {
+            &[0.0; 3][..]
+        } else {
+            values
+        };
+        let size = values
+            .len()
+            .checked_mul(4)
+            .and_then(|n| u64::try_from(n).ok())
+            .ok_or_else(|| RenderError("graphics buffer overflow".into()))?;
+        if size > device.limits().max_buffer_size {
+            return Err(RenderError("geometry exceeds graphics buffer limit".into()));
+        }
+        if self
+            .buffer
+            .as_ref()
+            .is_some_and(|buffer| buffer.size() < size)
+        {
+            self.buffer = None;
+        }
+        let buffer = self.buffer.get_or_insert_with(|| {
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some(label),
+                size,
+                usage: wgpu::BufferUsages::VERTEX | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            })
+        });
+        queue.write_buffer(buffer, 0, &bytes(values));
+        Ok(buffer)
+    }
 }
 
